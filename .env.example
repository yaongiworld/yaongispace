# Copy to .env.local for development. Nothing here is secret yet — the test
# database is disposable and local-only.
#
# Used by the integration test harness (see tests/db.ts). Override only if you
# changed the port in docker-compose.yml.
TEST_DATABASE_URL=postgresql://postgres:yaongi@127.0.0.1:54329/yaongispace_test

# The app's own origin, used as `metadataBase` so icon and manifest URLs
# absolutise correctly. Optional in development — it defaults to
# http://localhost:3000. Set it in production, or the home-screen icon links
# resolve against localhost.
# NEXT_PUBLIC_SITE_URL=https://yaongi.world
