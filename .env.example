# Copy to .env.local for development. Nothing in this file is a secret — the
# real values are, which is why .env.local is gitignored and this file only
# ever carries placeholders. Never paste a client secret in here.

# Used by the integration test harness (see tests/db.ts). Override only if you
# changed the port in docker-compose.yml. The database is `postgres` rather
# than one of our own: see the note in docker-compose.yml for why.
TEST_DATABASE_URL=postgresql://postgres:yaongi@127.0.0.1:54329/postgres

# --- Google sign-in ---------------------------------------------------------
#
# One Google Cloud project, one OAuth client of type "Web application", and
# nothing else. The consent screen requests `email` and `profile` only — both
# non-sensitive, so there is no verification step, no CASA assessment and no
# 7-day refresh-token expiry to work around (ADR-0005). If you ever find
# yourself adding a scope here, that whole apparatus comes back with it.
#
# GOOGLE_REDIRECT_URI must match an "Authorised redirect URI" in the Cloud
# console character for character, or Google refuses with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# The app's own connection to Postgres. In development this is the same
# disposable container the tests use; in production it is Supabase's connection
# string, which is a real secret and belongs only in .env.local and Vercel.
DATABASE_URL=postgresql://postgres:yaongi@127.0.0.1:54329/postgres

# Signs the session cookie. Any 32+ random characters; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out, which given that sessions never otherwise
# expire is the only logout this app has.
SESSION_SECRET=generate-your-own-at-least-32-characters-long

# Who may come through the door is NOT configured here — it is a table
# (`allowed_email`), so admitting a family member or a shared tablet later is
# an INSERT rather than a redeploy. Seed it once:
#
#   INSERT INTO allowed_email (email, note) VALUES
#     ('towee@example.com', '토위'), ('yangcho@example.com', '양초');

# --- Cloudflare R2, where photo bytes live -----------------------------------
#
# Not Supabase Storage, deliberately: Supabase bills one egress quota across
# database, auth and storage, which means a heavy month of photo browsing could
# break login — and hosted Supabase cannot point at your own bucket, so
# "adopt it now, swap later" is not an exit that exists (ADR-0012).
#
# Create one R2 bucket and one API token scoped to it (Object Read & Write).
# The access key pair is a real secret and belongs only in .env.local and
# Vercel — never here.
#
# Photos fail without these; nothing else does. The config is read lazily so an
# unconfigured R2 cannot take down sign-in.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=yaongi-photos

# Optional. A custom domain bound to the bucket, if you have one; without it
# URLs point at <account>.r2.cloudflarestorage.com, which works and is ugly.
# Bytes are served by *signed expiring URLs* either way — the bucket itself
# must stay private, so do not enable public access on it.
# R2_PUBLIC_HOST=photos.yaongi.world

# The app's own origin, used as `metadataBase` so icon and manifest URLs
# absolutise correctly. Optional in development — it defaults to
# http://localhost:3000. Set it in production, or the home-screen icon links
# resolve against localhost.
# NEXT_PUBLIC_SITE_URL=https://yaongi.world

# --- Photo storage -----------------------------------------------------------
#
# Cloudflare R2 in production (ADR-0012). Locally, `npm run app:up` runs MinIO,
# which speaks the same S3 API and the same SigV4 — so the signing path these
# variables drive is the one that runs against R2, not a stand-in for it.
#
# The compose file sets all of these for local development; you only need them
# here if you run the app outside Docker.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET=yaongi-photos

# Optional, and all four are for local S3-compatible servers only. Against R2
# leave every one of them unset.
#
#   R2_PUBLIC_HOST   what the *browser* is handed in a presigned URL
#   R2_INTERNAL_HOST what the *app* dials, when that differs — inside a
#                    container `localhost` is the app itself, so server-side
#                    reads need the service name
#   R2_SCHEME        `http`, for a local server with no certificate
#   R2_REGION        SigV4 scope; R2 wants `auto`, MinIO wants `us-east-1`
# R2_PUBLIC_HOST=localhost:9100
# R2_INTERNAL_HOST=storage:9000
# R2_SCHEME=http
# R2_REGION=us-east-1
