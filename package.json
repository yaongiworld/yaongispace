{
  "name": "yaongispace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:up": "docker compose -p yaongi-app --env-file .env.local -f compose.app.yml up -d --build --wait",
    "app:down": "docker compose -p yaongi-app --env-file .env.local -f compose.app.yml down",
    "app:logs": "docker compose -p yaongi-app --env-file .env.local -f compose.app.yml logs -f app",
    "migrate": "node scripts/migrate.mjs",
    "seed:dev": "DATABASE_URL=postgresql://postgres:yaongi@127.0.0.1:54330/postgres node scripts/seed-dev.mjs",
    "db:up": "docker compose --env-file .env.example up -d --wait",
    "db:down": "docker compose --env-file .env.example down -v"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
